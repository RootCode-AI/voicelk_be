# Copy to .env for local runs. In Azure set the same names as app settings / secrets.

# Supabase Postgres through the pooler (IPv4)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?user=<user>&password=<pass>

# Supabase storage (service role key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=

GEMINI_API_KEY=

# At least 32 characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=

# Firebase service account: the JSON itself (raw or base64) ...
FIREBASE_CREDENTIALS_JSON=
# ... or a path to the file. Defaults to src/main/resources/firebase-service-account.json.
# FIREBASE_CONFIG_PATH=file:/mnt/secrets/firebase-service-account.json

# TTS bridge on the VPS
TTS_BRIDGE_URL=http://127.0.0.1:8000
TTS_BRIDGE_API_KEY=

# Optional
# CORS_ALLOWED_ORIGINS=https://chat.voicelk.dev,http://localhost:5173
# PORT=8082
# JPA_SHOW_SQL=true
# TTS_AUTO_GENERATE=false
